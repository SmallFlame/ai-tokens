# ============================================================
#  生产环境敏感配置（存放于服务器，不提交 Git）
#  部署路径: /opt/ai-token/backend/.env
#  systemd 通过 EnvironmentFile 加载此文件
# ============================================================

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_token
DB_USERNAME=root
DB_PASSWORD=Root@2026Ai!

# Redis（若无密码留空）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# AES 密钥（16位，用于加密渠道 API Key，保持与初始化时一致）
AES_KEY=AiToken@2026!Key
